{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nekolife1984/specback/schemas/goal.schema.json",
  "title": "goal.json",
  "description": "Phase 0 で設定される specback のゴール定義。出力言語、テンプレート選定、granularity 等を記録する。",
  "type": "object",
  "properties": {
    "output_language": {
      "type": "string",
      "description": "出力言語",
      "enum": ["en", "ja"]
    },
    "output_dir": {
      "type": "string",
      "description": "最終仕様書の出力先ディレクトリ（.specback またはカスタムパス）",
      "default": ".specback"
    },
    "primary_reader": {
      "type": "string",
      "description": "仕様書の主な読み手",
      "enum": ["maintenance_developer", "delivery_customer", "sme", "regulator"]
    },
    "reader_action": {
      "type": "string",
      "description": "読み手が仕様書を読んだ後に行うアクション",
      "enum": ["code_change", "approval_decision", "audit", "learning"]
    },
    "granularity": {
      "type": "string",
      "description": "期待する粒度",
      "enum": ["high_level_overview", "medium", "detailed"]
    },
    "perspectives": {
      "type": "array",
      "description": "強調する観点（複数選択可）",
      "items": {
        "type": "string",
        "enum": ["functional_correctness", "business_validity", "security", "operability", "performance"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "existing_docs": {
      "type": "string",
      "description": "既存ドキュメントの扱い",
      "enum": ["none", "update", "coexist", "retire"]
    },
    "free_text_notes": {
      "type": "string",
      "description": "自由記述メモ"
    },
    "user_custom_deliverables": {
      "type": "array",
      "description": "ユーザーが free_text_notes で明示的に要求したカスタム成果物ファイル名",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*\\.md$"
      }
    },
    "depth_mode": {
      "type": "string",
      "description": "Depth モード",
      "enum": ["comprehensive", "outline", "interactive"]
    },
    "tone": {
      "type": "string",
      "description": "Writing tone — concise (compact, facts+REFs only) or thorough (detailed explanations)",
      "enum": ["concise", "thorough"]
    },
    "template": {
      "type": "string",
      "description": "Phase 1 で選択されたテンプレート名。coverage-check.py のデフォルト閾値の調整に使用される。「custom」は該当テンプレートなし（Phase 1 Step 3d ⚪ No template）の場合。",
      "enum": ["web-app", "batch-system", "api-service", "library-sdk", "cli-tool", "infrastructure", "mobile-app", "desktop-app", "event-driven", "custom"]
    },
    "reader_order_applied": {
      "type": "boolean",
      "description": "Phase 2 で reader_order による章順序の最適化が適用されたかどうか。reader_order が null または未定義の場合は false。",
      "default": false
    },
    "customized_chapters": {
      "type": "array",
      "description": "Phase 1 のコード分析による章構成カスタマイズ結果。検出ルールに基づき、各章の status を記録する。",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "description": "章のID（例: ch-auth, ch-screens）"},
          "title": {"type": "string", "description": "章のタイトル"},
          "status": {
            "type": "string",
            "description": "カスタマイズ結果",
            "enum": ["included", "excluded", "auto_added", "merged", "split"]
          },
          "note": {"type": ["string", "null"], "description": "検出結果の説明メッセージ"},
          "confidence": {
            "type": "string",
            "description": "検出の確信度",
            "enum": ["always", "high", "medium", "low"]
          },
          "review_note": {
            "type": ["string", "null"],
            "description": "Phase 1 Step 3d（Template fit critical review）での構造変更理由。null=変更なし、文字列=変更内容と理由。例: \"Auth is the most complex subsystem → moved to position 4\""
          }
        },
        "required": ["id", "title", "status"],
        "additionalProperties": false
      }
    },
    "chapter_actions_applied": {
      "type": "object",
      "description": "適用されたアクションの集計",
      "properties": {
        "excluded": {"type": "array", "items": {"type": "string"}},
        "auto_added": {"type": "array", "items": {"type": "string"}},
        "merged": {"type": "array", "items": {"type": "string"}},
        "split": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["excluded", "auto_added", "merged", "split"],
      "additionalProperties": false
    }
  },
  "required": [
    "output_language",
    "output_dir",
    "primary_reader",
    "reader_action",
    "granularity",
    "perspectives",
    "existing_docs"
  ],
  "additionalProperties": false
}
